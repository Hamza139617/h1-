long long computC(bool**& cluster, int*& sizes, int count, int& threshold, unsigned short* ptr = nullptr) {

    if (threshold >= (*sizes)) return 0;
    
    if(threshold == 0 )
    ptr = reinterpret_cast<unsigned short*>(*cluster++);
    

    long long currentVal = 0;
    

    // logic

    if (*ptr % 2 == 0) {
        currentVal = (currentVal << 1) + (*ptr);
    }
    else {
        currentVal = (currentVal >> 1) ^ (*ptr);
    }

    ptr++;
    threshold++;

    return currentVal + computC(cluster, sizes, count, threshold, ptr);
        
}

