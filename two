char* rotateString(char* str, int k) {

    char* str1 = new char[getLength(str) + 1];

    for (int i = 0; i < getLength(str) + 1; i++) *(str1 + i) = *(str + i);

    if (k == 0) return str1;

    while (k < 0) {
        char temp;
        int i;

        for ( i = getLength(str1) -1 ; i > 0 ; i-- ) {

            if (i == getLength(str1) - 1) {
                temp = *(str1 + i);
            }

            *(str1 + i) = *(str1 + i - 1);

        }

        *(str1 + i) = temp;
        k++;
    }

    while (k > 0) {
        char temp;
        int i;

        for (i = 0; i < getLength(str1) -1; i++ ) {

            if (i == 0 ) {
                temp = *(str1 + i);
            }

            *(str1 + i) = *(str1 + i + 1);

        }

        *(str1 + i) = temp;
        k--;
    }

    return str1;
}

