char* compress(const char* str) {


    char* d = new char[getLength(str) + 1];



    for (int i = 0; i < getLength(str) + 1; i++) *(d + i) = '\0';



    bool find = false;

    // this belw loop for calculation of occurences

    
    for (int i = 0; i < getLength(str); i++) { // for different occurences 

        int j;

        for (j = 0; *(d + j) != '\0'; j++) {

            if (*(d + j) == *(str + i)) {
                find = true;
                break;
            }

        }

        if (find == false) {
            *(d + j) = *(str + i);
        }
        find = false;

    }

    
    *(d + getLength(str)) = '\0';

    int n = getLength(d);
    

    char* counter = new char[n + 1];

    for (int i = 0; i < n; i++) {

        int count = 0;

        for (int j = 0; j < getLength(str); j++) {

            if (*(d + i) == *(str + j))
                count++;

        }

        *(counter + i) = char(count + 48);

    }
    *(counter + n) = '\0';

    char* result = new char[n * 2 + 1];

    for (int i = 0; i < n * 2; i++) *(result + i) = '\0';

    bool alternate = false;

    
    for (int j = 0, s = 0; j < n * 2; j++) {

        if (alternate == false) {

            *(result + j) = *(d + s);
            alternate = true;
        }
        else {
            *(result + j) = *(counter + s);
            alternate = false;
            s++;
        }

    }

    // ptins the backnash zero for the last
    *(result + n * 2) = '\0';

    delete[] counter;
    counter = nullptr;

    delete[] d;
    d = nullptr;

    return result;
}


