bool queenValidator(int**& b,int N,int i,int j) {
    
    if(j == 0 && i == 0 ) return true;
    
    if(
        (j > 0 && *(*(b + i ) + j - 1  ) == 0 )  &&
        (i == 0 && *(*(b + i ) + j ) == 0 )
        ) {
            return true;
        
            
        }else if(
            (j > 0 && j < N - 1  ) && 
            (i > 0 ) &&
            (*(*(b + i ) + j ) == 0 && *(*(b + i ) + j - 1 ) == 0 ) &&
            ( *(*(b + i - 1 ) + j ) == 0 && *(*(b + i - 1 ) + j - 1 ) == 0 ) && 
            ( *(*(b + i - 1 ) + j + 1 ) == 0 )
            ) {
                return true;
            }else if(
                *(*(b + i ) + j - 1) == 0 &&
                *(*(b + i - 1 ) + j ) == 0 &&
                *(*(b + i - 1 ) + j - 1 ) == 0 
                ) {
                    return true;
                }
                
                return false;
    
}


void fillboard(int**& b, int N, int i ) {
    if(i == N) return;
    
    *(b + i ) = new int[N]();
    
    i++;
    
    fillboard(b, N, i );
    
}

