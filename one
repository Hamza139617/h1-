#include <iostream>
using namespace std;

void fillboard(int**& b, int N , int i = 0 );
void queenValidator(int**&b, int N, int i = 0 );

int main() {
    
    int N;
    
    cout << "Enter the size of the board : ";
    cin >> N;
    
    
    int** board = new int*[N];
    
    fillboard(board, N);
    
    queenValidator(board, N);
    
    
    
    return 0;
}


void fillboard(int**& b, int N, int i ) {
    if(i == N) return;
    
    *(b + i ) = new int[N]();
    
    i++;
    
    fillboard(b, N, i );
    
}


